{
  "name": "liga-control",
  "version": "1.0.0",
  "description": "LigaControl — Basketball Scoreboard System",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.scoreboard.app",
    "productName": "Basketball Scoreboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "assets/**/*",
      "!**/*.test.{js,ts,tsx}",
      "!**/*.spec.{js,ts,tsx}",
      "!**/__tests__/**",
      "!**/*.md",
      "!.kiro/**",
      "!e2e/**"
    ],
    "extraResources": [
      {
        "from": "resources/overlay",
        "to": "resources/overlay",
        "filter": ["**/*"]
      },
      {
        "from": "resources/viewer",
        "to": "resources/viewer",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "icon": "assets/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [
    "scoreboard",
    "basketball",
    "liga"
  ],
  "author": "LigaControl",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/archiver": "8.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/form-data": "2.2.1",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "3.0.11",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.1",
    "@electron/rebuild": "4.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^2.3.0",
    "fast-check": "4.9.0",
    "jsdom": "^24.1.0",
    "jsqr": "1.4.0",
    "pngjs": "5.0.0",
    "supertest": "7.2.2",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "bcrypt": "6.0.0",
    "better-sqlite3": "12.11.1",
    "electron-store": "^8.2.0",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "fluent-ffmpeg": "2.1.3",
    "form-data": "4.0.6",
    "jspdf": "^2.5.2",
    "node-cron": "4.6.0",
    "qrcode": "1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "swagger-ui-express": "5.0.1",
    "unzipper": "0.12.5",
    "uuid": "14.0.1",
    "ws": "8.21.0",
    "zustand": "^4.5.0"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true
  }
}
